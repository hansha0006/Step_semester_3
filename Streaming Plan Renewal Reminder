import java.util.*;
import java.time.*;

abstract class Plan {
    LocalDate date;

    Plan(LocalDate date) {
        this.date = date;
    }

    abstract LocalDate renewalDate();
}

class Basic extends Plan {
    Basic(LocalDate date) {
        super(date);
    }

    LocalDate renewalDate() {
        return date.plusDays(30);
    }
}

class Standard extends Plan {
    Standard(LocalDate date) {
        super(date);
    }

    LocalDate renewalDate() {
        return date.plusDays(90);
    }
}

class Premium extends Plan {
    Premium(LocalDate date) {
        super(date);
    }

    LocalDate renewalDate() {
        return date.plusDays(365);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            String type = sc.next();
            String name = sc.next();
            LocalDate date = LocalDate.parse(sc.next());

            Plan p;

            switch (type) {
                case "BASIC":
                    p = new Basic(date);
                    break;

                case "STANDARD":
                    p = new Standard(date);
                    break;

                default:
                    p = new Premium(date);
            }

            System.out.println(name + ": " + p.renewalDate());
        }
    }
}
