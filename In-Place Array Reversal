
public class Main {
    public static void main(String[] args) {
        int[] a = {11, 22, 33, 44};

        int left = 0, right = a.length - 1;

        while (left < right) {
            int temp = a[left];
            a[left] = a[right];
            a[right] = temp;

            left++;
            right--;
        }

        for (int n : a)
            System.out.print(n + " ");
    }
}
